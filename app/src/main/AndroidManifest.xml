<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.itsaky.androidide.logsender" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".BiliTerminal"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icon"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.BiliClient"
        tools:ignore="LockedOrientationActivity,RtlEnabled"
        tools:replace="android:allowBackup"
        tools:targetApi="m">
        <service android:name=".service.DownloadService"
            android:foregroundServiceType="dataSync"
            android:enabled="true"/>
        <service android:name=".service.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:enabled="true"/>

        <!-- authority 必须用 ${applicationId} 占位符：代码里是 `packageName + ".FileProvider"`，
             coexistence flavor 的包名带 .coexist 后缀，写死会让共存版的下载安装/分享直接崩。 -->
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 缓存/下载的本地视频交给外部播放器（凉腕等）时的只读共享通道。
             FileProvider 的根是编译期资源、只能覆盖「主卷」（androidx 只取
             getExternalMediaDirs()[0] 等数组第一项）；用户把缓存路径改到外置 SD 卡后
             路径形如 /storage/XXXX-XXXX/Android/media/<包名>/...，FileProvider 会抛
             IllegalArgumentException: Failed to find configured root 把页面带崩。
             这个 provider 在运行时按「所有存储卷」算根，细节见 util/LocalFileProvider.kt。 -->
        <provider android:name=".util.LocalFileProvider"
            android:authorities="${applicationId}.LocalFileProvider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".activity.vote.VoteInfoActivity"
            android:exported="false"
            android:label="@string/uitext_voteinfoactivity_007"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.video.local.DownloadListActivity"
            android:exported="false"
            android:label="@string/uitext_cachelistadapter_001"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.video.series.SeriesInfoActivity"
            android:exported="false"
            android:label="@string/uitext_seriesinfoactivity_001"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.video.series.UserSeriesActivity"
            android:exported="false"
            android:label="@string/uitext_userseriesactivity_001"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.EmoteActivity"
            android:exported="false"
            android:label="@string/label_activity_no_24"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.video.collection.CollectionInfoActivity"
            android:exported="false"
            android:label="@string/uitext_collectioninfoactivity_001"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.live.LiveInfoActivity"
            android:exported="false"
            android:label="@string/label_activity_no_23"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.live.FollowLiveActivity"
            android:exported="false"
            android:label="@string/uitext_followliveactivity_001"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.live.RecommendLiveActivity"
            android:exported="false"
            android:label="@string/uitext_recommendliveactivity_001"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.user.FollowingBangumisActivity"
            android:exported="false"
            android:label="@string/uitext_followingbangumisactivity_001"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.settings.SponsorActivity"
            android:exported="false"
            android:label="@string/pagename_sponsoractivity_001"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.settings.UpdateHistoryActivity"
            android:exported="false"
            android:label="@string/pagename_updatehistoryactivity_001"
            android:screenOrientation="locked" />
        <!-- 26.10.04 批次 3（B8）：崩溃页跑独立进程 :error_activity。
             主进程此时已经处于"崩溃 + 即将 killProcess"的状态，同进程再启 Activity 很容易
             因为内存/状态被破坏而二次崩溃；独立进程只做最小初始化，能把堆栈稳定显示出来。 -->
        <activity
            android:name=".activity.CatchActivity"
            android:exported="false"
            android:process=":error_activity"
            android:label="@string/label_activity_no_22"
            android:screenOrientation="locked" />
        <!-- 26.10.09：自建反馈通道。与 B 站账号体系无关，不需要登录，故 exported=false 即可
             （只从关于页 / 设置页进入）。 -->
        <activity
            android:name=".activity.FeedbackActivity"
            android:exported="false"
            android:label="@string/pagename_feedback"
            android:screenOrientation="locked" />
        <!-- 26.10.16：「我的反馈」列表 + 详情（详情页可追加说明，走自建服务器的反馈对话接口）。
             入口只在设置「反馈与统计」分组，不需要被外部拉起，故 exported=false。
             详情页整条数据由列表页以 Parcelable extra 传入。 -->
        <activity
            android:name=".activity.feedback.FeedbackListActivity"
            android:exported="false"
            android:label="@string/feedback_mine_entry_title"
            android:screenOrientation="locked" />
        <activity
            android:name=".activity.feedback.FeedbackDetailActivity"
            android:exported="false"
            android:label="@string/uitext_feedbackdetailactivity_002"
            android:screenOrientation="locked" />
        <activity
            android:name=".tutorial.TutorialPagerActivity"
            android:exported="false"
            android:label="@string/pagename_tutorial"
            android:screenOrientation="locked"
            android:theme="@style/Theme.NoSwipe.AppCompat" />
        <activity
            android:name=".activity.GetIntentActivity"
            android:exported="true"
            android:label="@string/label_activity_no_21"
            android:screenOrientation="locked">
            <!-- 审计 P2-7：http/https 只接收 B 站域。
                 之前只声明 scheme、不写 host，等于把本应用注册成任意网页的打开方式：
                 用户点任何链接都可能弹本应用，且外部可用任意 URL 拉起本页。
                 bilibili:// 是自定义 scheme，仍单独放行（页面内再做 host 校验）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="bilibili" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- 通配符只匹配子域，裸域要单独写 -->
                <data
                    android:host="bilibili.com"
                    android:scheme="http" />
                <data
                    android:host="*.bilibili.com"
                    android:scheme="http" />
                <data
                    android:host="b23.tv"
                    android:scheme="http" />
                <data
                    android:host="bilibili.com"
                    android:scheme="https" />
                <data
                    android:host="*.bilibili.com"
                    android:scheme="https" />
                <data
                    android:host="b23.tv"
                    android:scheme="https" />
            </intent-filter>
        </activity>
        <!-- 外部视频入口：全应用第二个有意导出的 Activity。
             导出理由：要在文件管理器 / 相册 / 分享菜单里作为「打开方式」被第三方拉起，
             exported=false 就收不到 ACTION_VIEW / ACTION_SEND。
             安全边界：只接本地文件（content / file 且类型为 video/*），不接 http(s)——
             否则任何网页链接都能把本应用拉起来。页面自己不解码，交给内置播放器，
             且只读取调用方主动授权的那个 Uri（见 ExternalVideoActivity 注释）。 -->
        <activity
            android:name=".activity.player.ExternalVideoActivity"
            android:exported="true"
            android:label="@string/pagename_external_video"
            android:screenOrientation="locked">
            <intent-filter>
